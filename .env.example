# BM-RAG environment template. Copy to `.env` in the repository root and fill in values.
# Never commit the real `.env`.

# ── Chat model providers ───────────────────────────────
# Only the providers of the models you use need a key. See src/bmrag/llm.py.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
HUGGINGFACEHUB_API_TOKEN=
# Any OpenAI-style endpoint; use the model name openai-compatible:<model>
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=

# ── Model overrides (optional; defaults are in src/bmrag/profiles.py) ──
# Setting these leaves the paper_v1 configuration, so results are no longer comparable with the paper.
ANALYST_MODEL=
REASONER_MODEL=
PAPER_RERANK_MODEL=

# ── Embeddings ─────────────────────────────────────────
# Vector search always uses OpenAI text-embedding-3-small through OPENAI_API_KEY,
# because the stores were built with it. Other embeddings need a rebuilt index.

# ── Neo4j ──────────────────────────────────────────────
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ── Locations (optional; default to data/ and runs/ in the repository) ──
BMRAG_DATA_DIR=
BMRAG_RUNS_DIR=
